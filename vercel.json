{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/coverage.html" },
    { "source": "/coverage", "destination": "/coverage.html" },
    { "source": "/roster", "destination": "/roster.html" },
    { "source": "/staff", "destination": "/staff.html" },
    { "source": "/attendance", "destination": "/attendance.html" },
    { "source": "/leave-requests", "destination": "/leave-requests.html" }
  ]
}
